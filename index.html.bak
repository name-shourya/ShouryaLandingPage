<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data.Ops - Business Intelligence & Data Automation</title>
    <meta name="description" content="Eliminate Manual Reporting. Automate Your Business Intelligence with custom ETL pipelines and live dashboards.">
    <script src="https://cdn.tailwindcss.com"></script>
    <style type="text/tailwindcss">
        @layer utilities {
            .glass-nav {
                @apply bg-slate-900/80 backdrop-blur-md border-b border-slate-800;
            }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-300 font-sans antialiased selection:bg-blue-500/30">

    <!-- Navigation -->
    <nav class="fixed w-full top-0 z-50 glass-nav transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex-shrink-0 flex items-center">
                    <a href="#" class="text-2xl font-bold text-white tracking-tight">
                        Data<span class="text-blue-500">.Ops</span>
                    </a>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="#architecture" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Architecture</a>
                    <a href="#services" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Services</a>
                    <a href="#contact" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Contact</a>
                </div>
                <div class="md:hidden flex items-center">
                    <button type="button" class="text-slate-300 hover:text-white focus:outline-none" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="hidden md:hidden bg-slate-900 border-b border-slate-800" id="mobile-menu">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="#architecture" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Architecture</a>
                <a href="#services" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Services</a>
                <a href="#contact" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden min-h-screen flex items-center">
        <!-- Background decorative elements -->
        <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
            <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-blue-900/20 blur-[120px]"></div>
            <div class="absolute top-[40%] -right-[10%] w-[40%] h-[40%] rounded-full bg-indigo-900/20 blur-[100px]"></div>
            
            <!-- Grid pattern overlay -->
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="max-w-4xl mx-auto">
                <div class="inline-flex items-center px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-sm font-medium mb-8">
                    <span class="flex h-2 w-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span>
                    Modern Data Architecture
                </div>
                
                <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white tracking-tight mb-6 leading-tight">
                    Eliminate Manual Reporting. <br class="hidden lg:block"/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">Automate Your Business Intelligence.</span>
                </h1>
                
                <p class="mt-6 text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto leading-relaxed">
                    I build automated ETL pipelines that extract your siloed operational data into live, interactive dashboards. Zero manual spreadsheet updates required.
                </p>
                
                <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#contact" class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-900/30 transition-all duration-200 transform hover:-translate-y-1">
                        Request Free Proof of Concept
                        <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                    <a href="#architecture" class="inline-flex items-center justify-center px-8 py-4 border border-slate-700 text-base font-semibold rounded-lg text-white hover:bg-slate-800 hover:border-slate-500 transition-all duration-200">
                        View Technical Architecture
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Architecture Section -->
    <section id="architecture" class="py-24 bg-slate-900 border-t border-slate-800/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">End-to-End Data Pipeline Architecture</h2>
                <p class="text-lg text-slate-400 max-w-2xl mx-auto">Scalable data infrastructure designed for reliability, performance, and real-time insights.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Column 1: Extract -->
                <div class="bg-slate-800/50 border border-slate-700 p-8 rounded-2xl hover:bg-slate-800 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-900/20 transition-all duration-300 group">
                    <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center text-blue-400 mb-6 border border-blue-800 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Data Extraction</h3>
                    <p class="text-slate-400 mb-6">Connecting securely to APIs, MySQL databases, and cloud platforms.</p>
                    <div class="border-t border-slate-700/50 pt-4">
                        <p class="text-sm font-semibold text-slate-300 mb-2">Tools & Technologies</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-blue-300">SQL</span>
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-blue-300">REST APIs</span>
                        </div>
                    </div>
                </div>
                
                <!-- Column 2: Transform -->
                <div class="bg-slate-800/50 border border-slate-700 p-8 rounded-2xl hover:bg-slate-800 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-900/20 transition-all duration-300 group">
                    <div class="w-12 h-12 bg-indigo-900/50 rounded-lg flex items-center justify-center text-indigo-400 mb-6 border border-indigo-800 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Automated Transformation</h3>
                    <p class="text-slate-400 mb-6">Independent scripting and algorithmic cleaning of raw data into structured models.</p>
                    <div class="border-t border-slate-700/50 pt-4">
                        <p class="text-sm font-semibold text-slate-300 mb-2">Tools & Technologies</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-indigo-300">Python</span>
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-indigo-300">Pandas</span>
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-indigo-300">n8n</span>
                        </div>
                    </div>
                </div>

                <!-- Column 3: Load & Visualize -->
                <div class="bg-slate-800/50 border border-slate-700 p-8 rounded-2xl hover:bg-slate-800 hover:-translate-y-1 hover:shadow-xl hover:shadow-purple-900/20 transition-all duration-300 group">
                    <div class="w-12 h-12 bg-purple-900/50 rounded-lg flex items-center justify-center text-purple-400 mb-6 border border-purple-800 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Live Visualization</h3>
                    <p class="text-slate-400 mb-6">Deploying automated reporting architectures for operational and financial metrics.</p>
                    <div class="border-t border-slate-700/50 pt-4">
                        <p class="text-sm font-semibold text-slate-300 mb-2">Tools & Technologies</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-purple-300">Metabase</span>
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-purple-300">Streamlit</span>
                            <span class="px-2 py-1 text-xs font-medium bg-slate-900 border border-slate-700 rounded-md text-purple-300">Google Sheets integrations</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-24 bg-slate-800/30 border-t border-slate-800/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Specialized Implementation</h2>
                <p class="text-lg text-slate-400 max-w-2xl mx-auto">Specific technical consulting deliverables and automated solutions tailored for your business needs.</p>
            </div>
            
            <div class="flex flex-col gap-8 max-w-5xl mx-auto">
                <!-- Card 1 -->
                <div class="bg-slate-800 border-l-4 border-blue-500 rounded-r-2xl p-8 md:p-10 shadow-lg hover:shadow-xl hover:shadow-blue-900/20 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-4">Automated Overdue Account Extraction</h3>
                    <p class="text-lg text-slate-300">Automated daily extraction of customer account data via Metabase API queries, processed and routed into multi-sheet Excel workbooks for finance teams.</p>
                </div>
                
                <!-- Card 2 -->
                <div class="bg-slate-800 border-l-4 border-indigo-500 rounded-r-2xl p-8 md:p-10 shadow-lg hover:shadow-xl hover:shadow-indigo-900/20 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-4">Quantitative Volatility Modeling</h3>
                    <p class="text-lg text-slate-300">GJR-GARCH modeling and Sharpe Ratio optimization pipelines deployed via interactive Streamlit web applications.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-24 bg-slate-900 border-t border-slate-800/50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Claim Your Free Proof of Concept</h2>
            <p class="text-lg text-slate-400 mb-10">Before committing to a full build, I will automate one manual data workflow for your team at zero cost.</p>
            
            <form class="bg-slate-800/50 border border-slate-700 rounded-2xl p-8 text-left max-w-xl mx-auto" onsubmit="event.preventDefault();">
                <div class="mb-5">
                    <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Name</label>
                    <input type="text" id="name" name="name" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" required>
                </div>
                
                <div class="mb-5">
                    <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Work Email</label>
                    <input type="email" id="email" name="email" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" required>
                </div>
                
                <div class="mb-5">
                    <label for="website" class="block text-sm font-medium text-slate-300 mb-2">Company Website</label>
                    <input type="url" id="website" name="website" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
                </div>
                
                <div class="mb-8">
                    <label for="task" class="block text-sm font-medium text-slate-300 mb-2">What manual reporting task takes up the most time?</label>
                    <textarea id="task" name="task" rows="4" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" required></textarea>
                </div>
                
                <button type="submit" class="w-full flex justify-center py-4 px-4 border border-transparent rounded-lg shadow-sm text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 focus:ring-offset-slate-900 transition-colors">
                    Request Free Proof of Concept
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-slate-500 text-sm">
                &copy; 2026 Data.Ops Consulting. All rights reserved.
            </p>
            <a href="mailto:hello@data.ops" class="text-slate-400 hover:text-white transition-colors text-sm">
                hello@data.ops
            </a>
        </div>
    </footer>
    
    <script>
        // Smooth scrolling is handled by standard tailwind class "scroll-smooth" on html tag, 
        // fallback optional script could be placed here if needed.
    </script>
</body>
</html>
